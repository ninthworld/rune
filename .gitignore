# Rust
/target
**/target
# Node
node_modules/
dist/
# The e2e preview build (ADR 0011) — kept out of `dist/` so `npm run budget`
# keeps measuring the shipped artifact and not the hooks-enabled one.
dist-e2e/
*.tsbuildinfo
# Playwright e2e (ADR 0011) run artifacts
playwright-report/
test-results/
.playwright/
# Environment / secrets
.env
.env.*
!.env.example
# Private keys — never let a stray copy in the worktree become a commit.
*.pem
# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
# Logs
*.log
